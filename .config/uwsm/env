# NVIDIA Hyprland support
# see: https://wiki.hypr.land/Nvidia/ for latest information
export LIBVA_DRIVER_NAME=nvidia
export __GLX_VENDOR_LIBRARY_NAME=nvidia
export CUDA_DISABLE_PERF_BOOST=1

# WebKitGTK's DMA-BUF renderer exports buffers the NVIDIA driver describes with
# modifiers Hyprland rejects; the compositor kills the connection and the app dies
# with "Gdk-Message: Error 71 (Protocol error) dispatching to Wayland display".
# Hits every WebKitGTK app, and so every Tauri app (Music Assistant Companion is
# the one that surfaced it). Falls back to a slower GL path — on this GPU the
# dmabuf path doesn't work at all, so there's nothing to lose.
export WEBKIT_DISABLE_DMABUF_RENDERER=1

# export MOZ_DISABLE_UTILITY_SANDBOX=1

# Cursors
export HYPRCURSOR_THEME=macOS-hyper
export HYPRCURSOR_SIZE=24
export XCURSOR_SIZE=24
export XCURSOR_THEME=macOS

# Try to use Wayland
export SDL_VIDEODRIVER=wayland
export MOZ_ENABLE_WAYLAND=1
export QT_QPA_PLATFORM=wayland
# 1Password breaks with these settings for now
export ELECTRON_OZONE_PLATFORM_HINT=wayland
export OZONE_PLATFORM=wayland

# Qt
export QT_QPA_PLATFORMTHEME=qt6ct
